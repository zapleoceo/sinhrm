APP_NAME=SinHRM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=uk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# "Today" for the user (tasks, Маршрут дня); storage stays UTC
# APP_USER_TIMEZONE=Europe/Kyiv

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The only supported database: MySQL 8.4 (ADR 0011, docs/guides/deploy.md).
DB_CONNECTION=mysql
# Only bootstrap secrets live in env: DB_URL, APP_KEY, SUPERADMIN_EMAIL.
# All integration tokens are stored encrypted in the database (docs/architecture/secrets.md).
# DB_URL=mysql://<user>:<password>@<host>:3306/<database>   (or DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD)
DB_URL=
# MYSQL_ATTR_SSL_CA=/path/to/ca.pem   # when the server requires TLS
# DB_COLLATION=utf8mb4_0900_ai_ci     # default; charset utf8mb4, strict mode and UTC are fixed in config/database.php
SUPERADMIN_EMAIL=

# Google OAuth (Socialite). The secret is set only in Vercel env, never committed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://sinhrm.vercel.app/api/auth/google/callback
# SANCTUM_STATEFUL_DOMAINS=sinhrm.vercel.app,localhost:4200
# SESSION_SECURE_COOKIE=true
# Trust X-Forwarded-For only from these proxies (unset = nobody). Vercel: 127.0.0.1,::1 (backend/vercel.json).
# TRUSTED_PROXIES=
SESSION_SAME_SITE=lax

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
