### PUT /api/pulse/mood/settings — pulse.mood.settings.update
PUT {{host}}/api/pulse/mood/settings
Accept: application/json
Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}
X-XSRF-TOKEN: {{xsrf}}
Referer: {{host}}/
Content-Type: application/json

{
    "weekdays": [
        1
    ],
    "question": "Example question",
    "required": true,
    "alert_drop": 1.5,
    "min_group": 5
}

