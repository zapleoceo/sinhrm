### GET /api/safe-speak/me — GET /api/safe-speak/me — whether the current user handles reports (the UI shows the inbox link)
GET {{host}}/api/safe-speak/me
Accept: application/json
Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}

### GET /api/safe-speak/reports — safe-speak.reports.index
GET {{host}}/api/safe-speak/reports
Accept: application/json
Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}

### GET /api/safe-speak/reports/{report} — safe-speak.reports.show
GET {{host}}/api/safe-speak/reports/{{report}}
Accept: application/json
Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}

### PATCH /api/safe-speak/reports/{report} — safe-speak.reports.update
PATCH {{host}}/api/safe-speak/reports/{{report}}
Accept: application/json
Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}
X-XSRF-TOKEN: {{xsrf}}
Referer: {{host}}/
Content-Type: application/json

{
    "status": "new"
}

