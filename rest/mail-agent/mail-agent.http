Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}
X-XSRF-TOKEN: {{xsrf}}
Referer: {{host}}/
Content-Type: application/json

{
    "pattern": "Example pattern",
    "kind": "job_board"
}

