# Reports — main endpoints. Generated skeleton, synthetic data only.
# Path ids below are placeholders — replace with real ids from a list call.
@key = 1
@id = 1
# Variables: see rest/http-client.env.json (host, session, xsrf). How to get them: docs/guides/api.md
# Full list of Reports operations: /api/docs (tag "Reports").

### GET /api/reports/catalog — reports.catalog
GET {{host}}/api/reports/catalog
Accept: application/json
Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}

### GET /api/reports/catalog/{key} — reports.run
GET {{host}}/api/reports/catalog/{{key}}
Accept: application/json
Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}

### GET /api/reports/catalog/{key}/csv — reports.csv
GET {{host}}/api/reports/catalog/{{key}}/csv
Accept: application/json
Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}

