### GET /api/knowledge/categories — knowledge.categories.index
GET {{host}}/api/knowledge/categories
Accept: application/json
Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}

### POST /api/knowledge/categories — knowledge.categories.store
POST {{host}}/api/knowledge/categories
Accept: application/json
Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}
X-XSRF-TOKEN: {{xsrf}}
Referer: {{host}}/
Content-Type: application/json

{
    "name": "Example name"
}

