### GET /api/users — users.index
GET {{host}}/api/users
Accept: application/json
Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}

### POST /api/users — users.store
POST {{host}}/api/users
Accept: application/json
Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}
X-XSRF-TOKEN: {{xsrf}}
Referer: {{host}}/
Content-Type: application/json

{
    "email": "jane.doe@example.com",
    "name": "Example name",
    "role": "admin"
}

### PATCH /api/users/{user} — users.update
PATCH {{host}}/api/users/{{user}}
Accept: application/json
Cookie: {{session_cookie_name}}={{session}}; XSRF-TOKEN={{xsrf}}
X-XSRF-TOKEN: {{xsrf}}
Referer: {{host}}/
Content-Type: application/json

{
    "role": "admin",
    "status": "active",
