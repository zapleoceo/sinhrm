{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sinhrm-api.vercel.app/api/:path*" },
    { "source": "/sanctum/:path*", "destination": "https://sinhrm-api.vercel.app/sanctum/:path*" },
    { "source": "/((?!api/|sanctum/).*)", "destination": "/index.html" }
  ]
}
