{
  "name": "sinhrm-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run docs && ng serve",
    "build": "npm run docs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "docs": "node scripts/build-docs.mjs",
    "test:docs": "node --test scripts/build-docs.test.mjs scripts/vercel-headers.test.mjs",
    "e2e": "node e2e/run.mjs",
    "e2e:update": "node e2e/run.mjs --update",
    "e2e:visual": "node e2e/run.mjs --visual",
    "e2e:record": "node e2e/record-fixtures.mjs",
    "e2e:lint": "node --test e2e/inventory.test.mjs && eslint -c e2e/eslint.config.mjs e2e && tsc -p e2e/tsconfig.json"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@jsverse/transloco": "^8.4.0",
    "d3-hierarchy": "^3.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/wix-madefor-display": "^5.3.0",
    "@fontsource/wix-madefor-text": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "marked": "^18.0.14",
    "material-symbols": "^0.47.5",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
